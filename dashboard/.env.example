# FinDyn dashboard environment
#
# Copy to `.env` for local development, or set as a build-time variable in
# Cloudflare Pages / your CI. Only `PUBLIC_`-prefixed variables reach the
# browser bundle, which is what we want here: the dashboard is static and
# calls the API from the client at runtime.
#
# Base origin of the FinDyn serving plane. The dashboard appends `/api/v1`.
# Replace <account> with your Cloudflare account's workers.dev subdomain, or
# point it at a custom domain / `http://localhost:8787` for local dev.
PUBLIC_FINDYN_API=https://findyn.<account>.workers.dev
