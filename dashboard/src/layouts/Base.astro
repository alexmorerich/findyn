---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/app.css';

interface Props {
  title: string;
  description: string;
  /** Small uppercase label above the page heading. */
  eyebrow: string;
  heading: string;
  /** Short intro paragraph under the heading. */
  intro?: string;
}

const { title, description, eyebrow, heading, intro } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <title>{title} · FinDyn</title>
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%230b0f14'/%3E%3Cpath d='M5 22 L12 14 L18 19 L27 8' stroke='%234dd8e6' stroke-width='2.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E"
    />
  </head>
  <body>
    <a class="skiplink" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <div class="page-head">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{heading}</h1>
        {intro && <p>{intro}</p>}
      </div>
      <slot />
    </main>
    <Footer />
  </body>
</html>
