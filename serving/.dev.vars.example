# Copy to `.dev.vars` for local development (`wrangler dev`). Never commit `.dev.vars`.
# In production these are set with: wrangler secret put <NAME>

FRED_API_KEY=your_fred_key
BLS_API_KEY=your_bls_key
BEA_API_KEY=your_bea_key

# Shared secret for the compute plane's HMAC-signed write-back (§6, §14).
# Must match the ADMIN_HMAC_SECRET GitHub Actions secret used by compute/jobs/*.
ADMIN_HMAC_SECRET=generate_with_openssl_rand_hex_32
